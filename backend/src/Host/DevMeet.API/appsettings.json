{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Keycloak": {
    "Authority": "http://localhost:8082/realms/reactivities",
    "Audience": "reactivities-api",
    "RequireHttpsMetadata": false
  },
  "Hangfire": {
    "Enabled": true,
    "DashboardPath": "/hangfire",
    "SchemaName": "hangfire",
    "Queues": [ "critical", "default", "maintenance" ]
  },
  "Seeding": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173",
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "OpenTelemetry": {
    "ServiceName": "DevMeet.API",
    "SeqOtlpEndpoint": "http://localhost:5341/ingest/otlp/v1/traces",
    "JaegerOtlpEndpoint": "http://localhost:4317"
  },
  "ClientAppUrl": "http://localhost:3000",
  "CloudinarySettings": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "Resend": {
    "ApiKey": "",
    "FromEmail": "onboarding@resend.dev"
  },
  "Stripe": {
    "PublishableKey": "",
    "SecretKey": "",
    "WebhookSecret": ""
  },
  "ApiSettings": {
    "Title": "DevMeet Egypt API",
    "Version": "v1",
    "Description": "REST API for DevMeet Egypt - Tech Events & Meetups Platform.",
    "ContactName": "DevMeet Egypt Team",
    "ContactEmail": "ahmedbassl913@devmeet.com",
    "ContactUrl": "https://github.com/ahmed-Basal/Event-Hub"
  }
}
