{
  "uid": "eventhub-dependencies-background",
  "title": "5. Dependencies & Background Processing",
  "tags": ["event-hub", "outbox", "dependencies"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Outbound HTTP Duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_client_request_duration_seconds_bucket[5m])) by (le, server_address))", "legendFormat": "{{server_address}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 2,
      "title": "External Dependency Calls (Stripe / Resend / Cloudinary)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum by (dependency, operation, outcome) (rate(devmeet_dependency_calls_total[5m]))", "legendFormat": "{{dependency}}.{{operation}} ({{outcome}})", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 3,
      "title": "Outbox Batch Processing Duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(devmeet_outbox_batch_duration_ms_bucket[5m])) by (le))", "legendFormat": "p95 Batch Duration", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 4,
      "title": "Outbox Outcomes & Pending Backlog",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum by (outcome) (rate(devmeet_outbox_processed_total[5m]))", "legendFormat": "rate: {{outcome}}", "refId": "A" },
        { "expr": "devmeet_outbox_pending_messages", "legendFormat": "pending_count", "refId": "B" }
      ]
    }
  ]
}
