# Copy to .env for local Docker Compose / development (never commit .env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_DB=reactivities

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-keycloak-password

GRAFANA_ADMIN_PASSWORD=change-me-local-grafana-password

# Optional legacy symmetric JWT key (64+ chars) only needed during migration away from local JWTs
JWT_TOKEN_KEY=

# Optional MediatR commercial license key
MEDIATR_LICENSE_KEY=

# Next.js BFF OIDC Session Secret (32+ random bytes base64)
SESSION_SECRET=change-me-local-32-byte-session-secret
KEYCLOAK_CLIENT_ID=reactivities-web
KEYCLOAK_ISSUER=http://localhost:8082/realms/reactivities
KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/reactivities
